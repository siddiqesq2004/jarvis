{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "laptop-agent",
          "format": "url",
          "env": "LAPTOP_AGENT_SERVICE_URL"
        }
      ]
    },
    "laptop-agent": {
      "root": "services/laptop-agent",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
