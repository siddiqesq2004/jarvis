# ========================================================
# JARVIS AI COMPANION — ZERO-COST ENVIRONMENT CONFIGURATION
# ========================================================
# All services below have 100% permanent free tiers.
# NEVER commit real credentials to Git!

# --------------------------------------------------------
# 1. APPLICATION & HOSTING (Vercel Free Tier)
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In production on Vercel, set to: https://your-app-name.vercel.app

# --------------------------------------------------------
# 2. SUPABASE (Free Tier Database, Auth, and Realtime)
# --------------------------------------------------------
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Server-only key for authenticated background functions (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------
# 3. AI PROVIDER ADAPTER (Zero-Cost Free Tiers)
# --------------------------------------------------------
# Active Provider: "gemini" | "groq" | "mock"
AI_PROVIDER=gemini

# Primary: Google Gemini 1.5 / 2.0 Flash (Free tier via Google AI Studio)
# Free quota: 15 Requests/Min, 1,500 Requests/Day, 1M Tokens/Min — $0 cost
GEMINI_API_KEY=AIzaSy...

# Fallback: Groq Cloud (Free Tier - Llama 3.3 70B Versatile, ~800 tokens/sec)
# Free tier: 30 Requests/Min, 14,400 Requests/Day — $0 cost
GROQ_API_KEY=gsk_...

# --------------------------------------------------------
# 4. LAPTOP AGENT AVAILABILITY & HEARTBEAT CONFIGURATION
# --------------------------------------------------------
# Secret key used to sign and verify device registration tokens
DEVICE_TOKEN_SECRET=change-this-to-a-strong-random-secret-key-32-chars

# Heartbeat & Availability thresholds (in seconds)
# Laptop sends heartbeat every 30s. If none received in 90s, status becomes 'unavailable'.
HEARTBEAT_INTERVAL_SECONDS=30
LAPTOP_ONLINE_THRESHOLD_SECONDS=90

# --------------------------------------------------------
# 5. VOICE CONFIGURATION (100% Free Browser Web Speech API)
# --------------------------------------------------------
# "browser" uses client-side Web Speech STT/TTS (free, 0 latency, 0 quota)
VOICE_PROVIDER=browser
